{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trantramy",
  "version": "0.1.8",
  "identifier": "com.trantramy.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trantramy - Tran Tra My",
        "decorations": false,
        "contentProtected": true,
        "dragDropEnabled": false,
        "width": 1100,
        "height": 720,
        "minWidth": 520,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/yt-dlp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
