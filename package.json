{
  "name": "dlc",
  "version": "0.1.9",
  "description": "dlc desktop music player",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:icons": "node tests/icons.mjs",
    "test:lyrics": "node tests/lyrics.mjs && node tests/lyrics-state.mjs",
    "test:lyrics-ui": "node tests/lyrics-ui.mjs",
    "test:themes": "node tests/themes.mjs",
    "test:layout": "node tests/layout.mjs",
    "test:track-info": "node tests/track-info.mjs",
    "test:player": "node tests/player-errors.mjs",
    "test:karaoke": "node tests/karaoke.mjs",
    "test:karaoke:ui": "node tests/layout.mjs karaoke",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.71.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
